@@ -25,6 +25,11 @@ func unixToDate(date int, options ExportOptions) string {
 func pathToURI(path string) string {
 	// this is a jank fix, replace with something more robust?
 	uriPath := filepath.ToSlash(path)
+	// absolute Unix/macOS paths start with "/", which would otherwise give
+	// "file://localhost//Users/..."; UNC paths ("//server/share") are left alone
+	if strings.HasPrefix(uriPath, "/") && !strings.HasPrefix(uriPath, "//") {
+		uriPath = uriPath[1:]
+	}
 	uriPath = url.PathEscape(uriPath)
 	uriPath = strings.ReplaceAll(uriPath, "%2F", "/") // keep slashes
 	return "file://localhost/" + uriPath
