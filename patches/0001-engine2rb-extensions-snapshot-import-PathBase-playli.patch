@@ -0,0 +1,46 @@
+package engine_test
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/nateranda/djtools/engine"
+)
+
+func TestSnapshotLeavesSourceUntouched(t *testing.T) {
+	src := generateDatabase(t, filepath.Join(fixturesDir, "nestedPlaylists"))
+	before, _ := os.ReadFile(filepath.Join(src, "Database2", "m.db"))
+
+	tmp, err := engine.Snapshot(src)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.RemoveAll(tmp)
+	if v, err := engine.SchemaVersion(tmp); err != nil || v == "" {
+		t.Fatalf("schema version: %q %v", v, err)
+	}
+
+	lib, err := engine.ImportSnapshot(src, engine.ImportOptions{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(lib.Playlists) == 0 {
+		t.Fatal("expected playlists")
+	}
+	for _, s := range lib.Songs {
+		if !filepath.IsAbs(s.Path) || filepath.Dir(filepath.Dir(s.Path)) != filepath.Dir(src) {
+			t.Fatalf("path %q not resolved against source %q", s.Path, src)
+		}
+	}
+	after, _ := os.ReadFile(filepath.Join(src, "Database2", "m.db"))
+	if string(before) != string(after) {
+		t.Fatal("source m.db changed")
+	}
+}
+
+func TestSnapshotRejectsNonLibrary(t *testing.T) {
+	if _, err := engine.Snapshot(t.TempDir()); err != engine.ErrNotEngineLibrary {
+		t.Fatalf("got %v", err)
+	}
+}
diff --git a/lib/filter.go b/lib/filter.go
new file mode 100644
index 0000000..89b502b
--- /dev/null
+++ b/lib/filter.go
@@ -0,0 +1,89 @@
+package lib
+
+import "fmt"
+
+// FilterPlaylists returns a copy of the Library keeping only the playlists
+// whose PlaylistID is in keep. A playlist that is not itself selected but has
+// a selected descendant is kept as a folder: its own songs are dropped and
+// only the selected descendants remain under it. Songs are copied unchanged;
+// call PruneUnusedSongs on the result to drop songs no longer referenced.
+func (l *Library) FilterPlaylists(keep map[int]bool) Library {
+	return Library{
+		Songs:     append([]Song(nil), l.Songs...),
+		Playlists: filterPlaylists(l.Playlists, keep),
+	}
+}
+
+func filterPlaylists(playlists []Playlist, keep map[int]bool) []Playlist {
+	var out []Playlist
+	for _, p := range playlists {
+		children := filterPlaylists(p.SubPlaylists, keep)
+		selected := keep[p.PlaylistID]
+		if !selected && children == nil {
+			continue
+		}
+		np := Playlist{
+			PlaylistID:   p.PlaylistID,
+			Name:         p.Name,
+			SubPlaylists: children,
+		}
+		if selected {
+			np.Songs = append([]int(nil), p.Songs...)
+		}
+		out = append(out, np)
+	}
+	return out
+}
+
+// PruneUnusedSongs removes songs that are not referenced by any playlist.
+func (l *Library) PruneUnusedSongs() {
+	used := make(map[int]bool)
+	var walk func([]Playlist)
+	walk = func(playlists []Playlist) {
+		for _, p := range playlists {
+			for _, id := range p.Songs {
+				used[id] = true
+			}
+			walk(p.SubPlaylists)
+		}
+	}
+	walk(l.Playlists)
+
+	kept := make([]Song, 0, len(used))
+	for _, s := range l.Songs {
+		if used[s.SongID] {
+			kept = append(kept, s)
+		}
+	}
+	l.Songs = kept
+}
+
+// DedupePlaylistNames renames playlists that share a name with an earlier
+// sibling by appending " (2)", " (3)" and so on. Some software (Rekordbox,
+// for one) does not allow two playlists or folders with the same name at the
+// same level. It returns the number of playlists renamed.
+func (l *Library) DedupePlaylistNames() int {
+	return dedupeNames(l.Playlists)
+}
+
+func dedupeNames(playlists []Playlist) int {
+	renamed := 0
+	seen := make(map[string]bool)
+	for i := range playlists {
+		name := playlists[i].Name
+		if seen[name] {
+			for n := 2; ; n++ {
+				candidate := fmt.Sprintf("%s (%d)", playlists[i].Name, n)
+				if !seen[candidate] {
+					name = candidate
+					break
+				}
+			}
+			playlists[i].Name = name
+			renamed++
+		}
+		seen[name] = true
+		renamed += dedupeNames(playlists[i].SubPlaylists)
+	}
+	return renamed
+}
diff --git a/lib/filter_test.go b/lib/filter_test.go
new file mode 100644
index 0000000..5e6d717
--- /dev/null
+++ b/lib/filter_test.go
@@ -0,0 +1,71 @@
+package lib
+
+import (
+	"reflect"
+	"testing"
+)
+
+func sampleLibrary() Library {
+	return Library{
+		Songs: []Song{{SongID: 1}, {SongID: 2}, {SongID: 3}, {SongID: 4}},
+		Playlists: []Playlist{
+			{PlaylistID: 1, Name: "House", Songs: []int{1}, SubPlaylists: []Playlist{
+				{PlaylistID: 2, Name: "Deep", Songs: []int{2}},
+				{PlaylistID: 3, Name: "Tech", Songs: []int{3}},
+			}},
+			{PlaylistID: 4, Name: "Other", Songs: []int{4}},
+		},
+	}
+}
+
+func TestFilterKeepsAncestorsAsFolders(t *testing.T) {
+	l := sampleLibrary()
+	out := l.FilterPlaylists(map[int]bool{3: true})
+	want := []Playlist{{PlaylistID: 1, Name: "House", SubPlaylists: []Playlist{
+		{PlaylistID: 3, Name: "Tech", Songs: []int{3}},
+	}}}
+	if !reflect.DeepEqual(out.Playlists, want) {
+		t.Fatalf("got %+v", out.Playlists)
+	}
+	out.PruneUnusedSongs()
+	if len(out.Songs) != 1 || out.Songs[0].SongID != 3 {
+		t.Fatalf("prune: got %+v", out.Songs)
+	}
+	// original untouched
+	if len(l.Playlists) != 2 || len(l.Songs) != 4 {
+		t.Fatal("source library was modified")
+	}
+}
+
+func TestFilterNothingSelected(t *testing.T) {
+	l := sampleLibrary()
+	out := l.FilterPlaylists(map[int]bool{})
+	if out.Playlists != nil {
+		t.Fatalf("expected no playlists, got %+v", out.Playlists)
+	}
+}
+
+func TestDedupe(t *testing.T) {
+	l := Library{Playlists: []Playlist{
+		{Name: "A"}, {Name: "A"}, {Name: "B", SubPlaylists: []Playlist{{Name: "x"}, {Name: "x"}}}, {Name: "A"},
+	}}
+	if n := l.DedupePlaylistNames(); n != 3 {
+		t.Fatalf("renamed %d, want 3", n)
+	}
+	got := []string{l.Playlists[0].Name, l.Playlists[1].Name, l.Playlists[3].Name, l.Playlists[2].SubPlaylists[1].Name}
+	want := []string{"A", "A (2)", "A (3)", "x (2)"}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %v", got)
+	}
+}
+
+func TestCheckCorruptedSongsAdjacent(t *testing.T) {
+	l := Library{
+		Songs:     []Song{{SongID: 1}, {SongID: 2, Corrupt: true}, {SongID: 3, Corrupt: true}},
+		Playlists: []Playlist{{Name: "p", Songs: []int{1, 2, 3}}},
+	}
+	l.CheckCorruptedSongs()
+	if len(l.Songs) != 1 || l.Songs[0].SongID != 1 || !reflect.DeepEqual(l.Playlists[0].Songs, []int{1}) {
+		t.Fatalf("got %+v %+v", l.Songs, l.Playlists)
+	}
+}
