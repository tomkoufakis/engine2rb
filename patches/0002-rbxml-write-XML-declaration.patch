From 3db47d23b942ac9f474e020facc7053e918b8c17 Mon Sep 17 00:00:00 2001
From: engine2rb <dev@example.com>
Date: Thu, 5 Nov 2026 22:33:51 +0000
Subject: [PATCH 2/2] rbxml: write XML declaration

---
 rbxml/rbxml.go                                | 6 ++++--
 rbxml/testdata/export/xml/cuesLoops.xml       | 1 +
 rbxml/testdata/export/xml/empty.xml           | 1 +
 rbxml/testdata/export/xml/history.xml         | 1 +
 rbxml/testdata/export/xml/nestedPlaylists.xml | 1 +
 rbxml/testdata/export/xml/playlists.xml       | 1 +
 rbxml/testdata/export/xml/songs.xml           | 1 +
 7 files changed, 10 insertions(+), 2 deletions(-)

diff --git a/rbxml/rbxml.go b/rbxml/rbxml.go
index be5eb0d..d7d1a1c 100644
--- a/rbxml/rbxml.go
+++ b/rbxml/rbxml.go
@@ -125,12 +125,14 @@ func (d *djPlaylists) sort() {
 
 // write writes a djPlaylists struct to a XML file at the given path
 func (d *djPlaylists) write(path string) error {
-	xml, err := xml.MarshalIndent(d, " ", "  ")
+	data, err := xml.MarshalIndent(d, " ", "  ")
 	if err != nil {
 		return err
 	}
+	// Rekordbox's own XML exports start with a declaration; include one too
+	data = append([]byte(xml.Header), data...)
 
-	err = os.WriteFile(path, xml, 0644)
+	err = os.WriteFile(path, data, 0644)
 	if err != nil {
 		return fmt.Errorf("error exporting library: %v", err)
 	}
diff --git a/rbxml/testdata/export/xml/cuesLoops.xml b/rbxml/testdata/export/xml/cuesLoops.xml
index 17561dc..bf7ae30 100644
--- a/rbxml/testdata/export/xml/cuesLoops.xml
+++ b/rbxml/testdata/export/xml/cuesLoops.xml
@@ -1,3 +1,4 @@
+<?xml version="1.0" encoding="UTF-8"?>
  <DJ_PLAYLISTS Version="1.0.0">
    <PRODUCT Name="djtools" Version="0.1" Company="djtools"></PRODUCT>
    <COLLECTION Entries="5">
